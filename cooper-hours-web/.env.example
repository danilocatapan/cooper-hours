# Desenvolvimento local. A chave pessoal é informada somente pela interface.
REDMINE_API_PORT=3001
REDMINE_WRITE_MODE=disabled
AUTOMATION_SIGNING_KEY=troque-por-uma-chave-local-com-32-caracteres

# Esta flag é pública e apenas controla a exibição do painel no frontend.
VITE_REDMINE_INTEGRATION_ENABLED=true
VITE_BASE_PATH=/cooper-hours/

# Produção (Render + Cloudflare Access):
# APP_ORIGIN=https://horas.exemplo.com.br
# DATABASE_URL=postgresql://...
# CLOUDFLARE_ACCESS_TEAM_DOMAIN=https://sua-equipe.cloudflareaccess.com
# CLOUDFLARE_ACCESS_AUD=audience-da-aplicacao
